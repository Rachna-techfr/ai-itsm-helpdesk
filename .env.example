# Copy to backend/.env if you want cloud integrations. Never commit real secrets.
# The demo runs with every variable left blank.

# MongoDB Atlas. Leave blank to use backend/data/store.json.
MONGODB_URI=
MONGODB_DB=northline_itsm
# Atlas Vector Search index name on the kb_chunks collection (384 dims, cosine).
# Leave blank to use in-process cosine similarity over stored embeddings.
MONGODB_VECTOR_INDEX=

# Hugging Face inference. Leave blank to use the local demo model.
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-3B-Instruct

# Optional local model. Used only when HF_TOKEN is empty and this URL is set.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2

# Embeddings: auto (MiniLM if sentence-transformers imports, else hash TF-IDF),
# hash-tfidf, or minilm.
EMBEDDING_BACKEND=auto

# ServiceNow Table API. Leave blank to use the mock that issues INC/REQ numbers.
# Instance is the subdomain of https://INSTANCE.service-now.com
SERVICENOW_INSTANCE=
SERVICENOW_USER=
SERVICENOW_PASSWORD=
# Alternative to the password: a bearer token. User + password is the usual Table API pair.
SERVICENOW_TOKEN=

# Where local JSON is stored when MongoDB is not used.
DATA_DIR=

# Set to 1 only in tests so provisioning finishes inline.
DEMO_SYNC_PROVISION=
